# --- Core ---
DATABASE_URL=postgres://roster:roster@localhost:5432/roster
# Public base URL of the app (used for links in emails, webhooks, OAuth redirects)
APP_URL=http://localhost:3000
# 32-byte base64 key used for AES-256-GCM encryption of secrets at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Secret for signing session/magic-link tokens. Generate: openssl rand -base64 48
AUTH_SECRET=

# --- AI ---
# When unset, Roster runs with a deterministic offline model (demo/test mode).
ANTHROPIC_API_KEY=
ROSTER_MODEL_SMART=claude-opus-5-5
ROSTER_MODEL_FAST=claude-haiku-5-5
# Optional embeddings for knowledge base (falls back to Postgres full-text search)
VOYAGE_API_KEY=

# --- Email (agents each get their own inbox: <handle>@<EMAIL_DOMAIN>) ---
EMAIL_DOMAIN=agents.example.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Slack ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- Agent computers (cloud desktops) ---
ORGO_API_KEY=

# --- Billing ---
# Billing (Stripe Connect, Standard accounts). Unset = test mode: plans/subscriptions are records, nobody is charged.
# Webhook endpoint: POST /api/webhooks/stripe — subscribe the platform endpoint AND a Connect endpoint ("events on
# connected accounts") to: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid,
# invoice.payment_failed, account.updated, account.application.deauthorized.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect endpoint if it differs (STRIPE_WEBHOOK_SECRET may also be a comma-separated list).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Platform application fee on subscriptions, in basis points (250 = 2.5%). Default 0.
PLATFORM_FEE_BPS=0

# --- Worker ---
WORKER_CONCURRENCY=8

# --- Network ---
# Number of trusted proxies in front of the app (load balancer/CDN). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=1
