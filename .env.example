# Every variable the app reads. Empty = unset. In production (NODE_ENV=production) web and worker refuse to start
# when ENCRYPTION_KEY/AUTH_SECRET are missing or malformed, or APP_URL is not https (localhost is allowed);
# /api/health names the problem (never the value).

# --- Core ---
DATABASE_URL=postgres://roster:roster@localhost:5432/roster
# Connections per process (web and each worker). Default 10. Keep (web + workers) x this under Postgres max_connections.
DB_POOL_MAX=10
# Public base URL of the app (used for links in emails, webhooks, OAuth redirects). Must be https in production.
APP_URL=http://localhost:3000
# Extra hostnames that serve the app itself (comma-separated), not client custom domains. APP_URL's host is implied.
ROSTER_APP_HOSTS=
# REQUIRED in production. 32-byte base64 key for AES-256-GCM encryption of secrets at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# REQUIRED in production (32+ chars). Signs session/magic-link/OAuth-state tokens. Generate: openssl rand -base64 48
AUTH_SECRET=
# fatal | error | warn | info (default) | debug | trace | silent
LOG_LEVEL=info
# Escape hatch for smoke tests only: boot production without the checks above. Never set in a real deployment.
ROSTER_ALLOW_INSECURE_DEFAULTS=

# --- AI ---
# When unset, Roster runs with a deterministic offline model (demo/test mode).
ANTHROPIC_API_KEY=
ROSTER_MODEL_SMART=claude-opus-5-5
ROSTER_MODEL_FAST=claude-haiku-5-5
# Optional embeddings for knowledge base (falls back to Postgres full-text search)
VOYAGE_API_KEY=

# --- Email (agents each get their own inbox: <handle>@<EMAIL_DOMAIN>) ---
EMAIL_DOMAIN=agents.example.com
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# authserv-id of the receiving MTA's Authentication-Results header (the first token, e.g. "mx.resend.com").
# Only that header decides whether an inbound sender passed DMARC/SPF/DKIM; headers the sender wrote are ignored.
# Unset = no inbound email counts as verified (replies to members are held for approval). Required in production with Resend.
# Check a received message's raw headers to confirm the exact value. Comma-separate several.
EMAIL_AUTHSERV_ID=

# --- SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Slack ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Hosts an inbound attachment download_url may point at (suffix match, comma-separated). Default: provider hosts.
ATTACHMENT_DOWNLOAD_HOSTS=

# --- Agent computers (cloud desktops) ---
ORGO_API_KEY=
# Override the Orgo API base URL (default https://www.orgo.ai/api).
ORGO_API_URL=

# --- MCP ---
# Extra browser origins allowed to call /api/mcp (comma-separated). APP_URL's origin is always allowed.
MCP_ALLOWED_ORIGINS=

# --- Approvals ---
# Hours a pending approval waits for a human before it expires (default 168 = 7 days).
APPROVAL_TTL_HOURS=168

# --- Billing ---
# Billing (Stripe Connect, Standard accounts). Unset = test mode: plans/subscriptions are records, nobody is charged.
# Webhook endpoint: POST /api/webhooks/stripe — subscribe the platform endpoint AND a Connect endpoint ("events on
# connected accounts") to: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid,
# invoice.payment_failed, account.updated, account.application.deauthorized.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect endpoint if it differs (STRIPE_WEBHOOK_SECRET may also be a comma-separated list).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Platform application fee on subscriptions, in basis points (250 = 2.5%). Default 0.
PLATFORM_FEE_BPS=0

# --- Worker ---
# Jobs one worker runs at once.
WORKER_CONCURRENCY=8
# Heartbeat file the worker touches every 10s; the image HEALTHCHECK (dist/worker-health.mjs) reads it.
WORKER_HEARTBEAT_FILE=/tmp/roster-worker.heartbeat
# Let the web tier run a queued Architect job itself when no worker took it within a few seconds. Always on in
# development; production default off (run a worker). Set to 1 only for single-box installs without a worker.
ROSTER_INLINE_JOBS=
# Where the migrator finds drizzle/ (default: next to the source or the bundle).
MIGRATIONS_DIR=

# --- Web server (standalone) ---
PORT=3000
HOSTNAME=0.0.0.0

# --- Network ---
# Number of trusted proxies in front of the app (load balancer/CDN). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=1
